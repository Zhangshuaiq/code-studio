{
  "name": "ai-codegen-platform",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:api dev:worker dev:web",
    "dev:api": "npm run start:dev --workspace apps/api",
    "dev:web": "npm run dev --workspace apps/web",
    "dev:worker": "npm run start:worker:dev --workspace apps/api",
    "build": "npm run build --workspace apps/api && npm run build --workspace apps/web",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "backup:db": "./scripts/postgres-backup.sh",
    "restore:db": "./scripts/postgres-restore.sh",
    "prisma:generate": "npm run prisma:generate --workspace apps/api",
    "prisma:migrate": "npm run prisma:migrate --workspace apps/api",
    "supply-chain:validate": "node scripts/validate-supply-chain.mjs",
    "supply-chain:validate:production": "node scripts/validate-supply-chain.mjs --production"
  },
  "devDependencies": {
    "@nestjs/common": "11.2.1",
    "@nestjs/core": "11.2.1",
    "@nestjs/platform-express": "11.2.1",
    "dompurify": "3.4.14",
    "glob": "10.5.0",
    "npm-run-all": "^4.1.5"
  },
  "engines": {
    "node": ">=22.19"
  },
  "overrides": {
    "@nestjs/common": "11.2.1",
    "@nestjs/core": "11.2.1",
    "dompurify": "3.4.14",
    "glob": "10.5.0"
  }
}
